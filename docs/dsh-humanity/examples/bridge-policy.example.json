{
  "schema_version": 1,
  "policy_version": "dsh-live-v1.0",
  "example_only": true,
  "deployment": {
    "mode": "native_windows",
    "project_root_env": "STREAM_PROJECT_ROOT",
    "bridge_host": "127.0.0.1",
    "bridge_port": 3092,
    "management_host": "127.0.0.1",
    "management_port": 3091,
    "state_relative_path": "state/female-a",
    "dsh_home_relative_path": "state/female-a/dsh-home"
  },
  "versions": {
    "dsh_candidate": "0.2.0-rc.2",
    "humanity_base": "0.1.17",
    "node_minimum_major": 22,
    "runtime_validation_required": true,
    "humanity_connector_patch_required": true,
    "allow_unpinned_dependencies": false
  },
  "identity": {
    "character_id": "female-a",
    "room_id": "room-main",
    "character_source": "configs/characters/female-a.json",
    "anonymous_cross_broadcast_memory": false,
    "viewer_identity_source": "server_verified_principal"
  },
  "conversation": {
    "session_strategy": "per_request_standard",
    "active_requests_per_room": 1,
    "pending_queue_limit": 4,
    "queued_input_ttl_ms": 180000,
    "active_request_deadline_ms": 300000,
    "model_timeout_ms": 90000,
    "tts_timeout_ms": 120000,
    "input_max_chars": 1500,
    "final_speech_max_chars": 160,
    "max_memory_tool_rounds": 2,
    "context_max_estimated_tokens": 6000,
    "max_output_tokens": 256,
    "rolling_summary_event_threshold": 16,
    "rolling_summary_max_chars": 1200,
    "speak_intermediate_model_text": false,
    "silent_stateless_fallback": false
  },
  "playback": {
    "media_protocol": 2,
    "authorities_per_broadcast": 1,
    "heartbeat_interval_ms": 1000,
    "lease_timeout_ms": 8000,
    "progress_interval_ms": 250,
    "cancel_ack_window_ms": 10000,
    "drain_timeout_ms": 30000,
    "require_contiguous_samples": true,
    "require_natural_end": true,
    "accept_partial_text_without_alignment": false,
    "evidence_level": "consumer_playout"
  },
  "memory": {
    "canonical_store": "sqlite",
    "humanity_projection": "public_only",
    "native_humanity_mutation_tools_in_live_agent": false,
    "native_humanity_evolution": false,
    "native_humanity_dream": false,
    "public_max_inject": 3,
    "public_max_chars": 300,
    "viewer_max_inject": 3,
    "viewer_max_chars": 500,
    "fact_content_max_chars": 160,
    "source_quote_max_chars": 300,
    "allow_vector_gpu_model": false,
    "allow_automatic_persona_changes": false,
    "allow_automatic_conflict_overwrite": false,
    "read_canonical_if_projection_lags": true
  },
  "maintenance": {
    "scheduler": "bridge_persistent_jobs",
    "timezone": "Asia/Taipei",
    "poll_interval_ms": 5000,
    "post_broadcast_quiet_ms": 120000,
    "daily_local_time": "03:30",
    "weekly_iso_weekday": 1,
    "weekly_local_time": "04:10",
    "catch_up_window_ms": 43200000,
    "concurrency": 1,
    "lease_timeout_ms": 120000,
    "lease_heartbeat_ms": 15000,
    "model_timeout_ms": 90000,
    "chunk_max_events": 200,
    "chunk_max_utf8_bytes": 24000,
    "overlap_events": 2,
    "max_output_tokens_per_call": 1600,
    "max_model_calls_per_run": 8,
    "max_model_calls_per_day": 20,
    "max_attempts_per_chunk": 5,
    "backoff_initial_ms": 5000,
    "backoff_max_ms": 300000,
    "commit_during_live": false,
    "automatic_historical_backfill": false,
    "allow_raw_dsh_session_scan": false
  },
  "storage": {
    "sqlite_journal_mode": "WAL",
    "sqlite_synchronous": "FULL",
    "sqlite_foreign_keys": true,
    "sqlite_busy_timeout_ms": 5000,
    "network_filesystem": false,
    "automatic_raw_event_deletion": false,
    "deletion_fences_required_for_restore": true,
    "backup_before_migration": true
  }
}
