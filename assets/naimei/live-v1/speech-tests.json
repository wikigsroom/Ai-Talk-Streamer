[
  {
    "id": "NM-SP-intro",
    "purpose": "自我介绍",
    "text": "大家好，我是奶妹。今天也一起待一会儿吧。"
  },
  {
    "id": "NM-SP-vowels-a",
    "purpose": "连续元音",
    "text": "啊，哦，呃，咿，呜，迂。阿姨一路问我，屋外有没有乌云。"
  },
  {
    "id": "NM-SP-bilabial",
    "purpose": "双唇音",
    "text": "爸爸抱着宝宝，慢慢把苹果搬过来。"
  },
  {
    "id": "NM-SP-labiodental",
    "purpose": "唇齿音",
    "text": "芳芳分发饭盒，风吹翻了粉色围巾。"
  },
  {
    "id": "NM-SP-alveolar",
    "purpose": "舌尖音",
    "text": "弟弟拿着蓝色袋子，等到天亮再出门。"
  },
  {
